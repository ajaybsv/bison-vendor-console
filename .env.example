# Local Postgres. On Vercel, connect a Prisma Postgres database with the env prefix
# "bison_vendor" instead — it provides bison_vendor_DATABASE_URL(_POOLED).
DATABASE_URL="postgresql://postgres:password@localhost:5432/bison_vendor_console"

# Mailjet (password-reset emails). MAILJET_EMAIL must be a verified sender.
MAILJET_EMAIL="no-reply@example.com"
MAILJET_API_KEY=""
MAILJET_API_SECRET=""
