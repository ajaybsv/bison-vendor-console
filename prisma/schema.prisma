generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Dates the UI only ever shows as calendar days (due, expiry, next review…) are
// stored as ISO `YYYY-MM-DD` strings, matching the admin console's convention.

// ---------- Organization (the vendor company using this portal) ----------

model Organization {
  id             Int     @id @default(autoincrement())
  name           String
  regNo          String?
  vendorType     String?
  tech           String?
  primaryContact String?
  address        String?
  notifReminders Boolean @default(true)
  notifDigest    Boolean @default(true)
  notifExpiry    Boolean @default(true)
  // ---- Materiality thresholds (4) — org-configured, never hard-coded. Stored as text
  // like every other numeric-looking field in this app; parsed where used. ----
  materialityDisruptionHours  String?
  materialityCustomerPct      String?
  materialityFinancialImpact  String?
  // ---- Tiering & approval escalation rules (5A / 6) — org-configured, never hard-coded. ----
  tierConcentrationTrigger      String?
  tierLimitedAlternativesTrigger String?
  approvalCeoTrigger            String?
  approvalBoardTrigger          String?

  @@map("organization")
}

// ---------- Team & auth ----------

model TeamMember {
  id           Int             @id @default(autoincrement())
  name         String
  email        String          @unique
  role         String          @default("Viewer")
  status       String          @default("Invited")
  passwordHash String?
  inviteToken  String?         @unique
  createdAt    DateTime        @default(now())
  sessions     Session[]
  resets       PasswordReset[]

  @@map("team_members")
}

model Session {
  id        String     @id
  memberId  Int
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([memberId])
  @@map("sessions")
}

/// A forgot-password link. `id` is the SHA-256 of the emailed token; single use, short-lived.
model PasswordReset {
  id        String     @id
  memberId  Int
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([memberId])
  @@map("password_resets")
}

// ---------- Requests from clients (we are the vendor being assessed) ----------

model ClientRequest {
  id          Int               @id @default(autoincrement())
  client      String
  kind        String
  frameworks  String[]          @default([])
  due         String?
  contact     String?
  qDone       Int               @default(0)
  qTotal      Int               @default(0)
  evDone      Int               @default(0)
  evTotal     Int               @default(0)
  status      String            @default("In progress")
  reqEvidence String[]          @default([])
  createdAt   DateTime          @default(now())
  answers     WorkspaceAnswer[]

  @@map("client_requests")
}

/// The vendor's working answer to one bank question inside one client request.
model WorkspaceAnswer {
  id         Int           @id @default(autoincrement())
  requestId  Int
  request    ClientRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  questionId String
  value      String?
  confirmed  Boolean       @default(false)

  @@unique([requestId, questionId])
  @@map("workspace_answers")
}

model HistoryEntry {
  id          Int      @id @default(autoincrement())
  client      String
  completedOn String
  frameworks  String[] @default([])
  compliance  Int

  @@map("history")
}

// ---------- Trust Pack ----------

model TrustAnswer {
  id        Int      @id @default(autoincrement())
  control   String
  q         String
  a         String
  updated   String?
  used      Int      @default(0)
  createdAt DateTime @default(now())

  @@map("trust_answers")
}

model EvidenceItem {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  uploaded  String?
  expiry    String?
  freshness String   @default("fresh")
  usedBy    String[] @default([])
  // When set, this is assurance evidence (SOC/ISO report, certificate…) for a specific
  // vendor of ours — matching how Issue.vendor stores a vendor's name, not a foreign key.
  // Blank means it's a Trust Pack item we hold on ourselves.
  vendor    String?
  createdAt DateTime @default(now())

  @@map("evidence_items")
}

// ---------- Question bank (BISON control library slice) ----------

model Question {
  id             String   @id
  position       Int
  control        String
  text           String
  type           String
  options        String[] @default([])
  inTrustPack    Boolean  @default(false)
  defaultValue   String?
  sourceAnswerId Int?

  @@map("questions")
}

// ---------- Our own vendors (we are the assessor) ----------

model Vendor {
  id                  Int             @id @default(autoincrement())
  name                String
  type                String
  servicesDescription String?
  contactName         String
  contact             String
  contactPhone        String?
  owner               String
  criticality         String
  dataSensitivity     String
  frameworks          String[]        @default([])
  country             String?
  contractStart       String?
  cadence             String
  nextReview          String?
  // ---- Concentration & dependency (8B) ----
  legalEntity            String?
  parentGroup            String?
  subcontractors         String?
  cloudProviders         String?
  internalDependencies   String?
  alternativeProviders   String?
  dependencyReviewStatus String          @default("Pending")
  // Annual spend with this vendor — feeds the "aggregate provider exposure"
  // concentration/materiality factor when vendors share a dependency.
  annualSpend            String?
  // ---- Vendor tiering (5A) — tier itself is always derived; only the override is stored. ----
  tierOverride           String?
  tierOverrideReason     String?
  // ---- Materiality impact inputs (4) — measurable facts, compared against the
  // organisation's own configured thresholds, never a universal cutoff. ----
  disruptionToleranceHours String?
  customersAffectedPct     String?
  financialImpactEstimate String?
  // ---- Approval workflow (6) — who must review is always derived; only the overall
  // decision status is tracked here. ----
  approvalStatus      String          @default("Not started")
  // Which required-approver roles have signed off. Each change is logged to the
  // activity log by role (gap 6/7) — the sign-off trail itself lives there, not here.
  approverSignoffs    String[]        @default([])
  // ---- Cross-functional confirmation (7) — traceability that each team's own
  // assessment ran; never duplicates their actual due-diligence. ----
  crossFunctionalConfirmations String[]        @default([])
  // ---- Exit management (11) — tracked once onboarded; most vendors never need it. ----
  exitPlanStatus       String          @default("Not Required")
  exitTransitionDate   String?
  dataReturnStatus     String?
  exitClosureEvidence  String?
  // ---- Vendor Registration wizard (2) — the business-friendly intake questions behind the
  // guided sign-up flow. Optional: vendors created before this existed, or edited directly via
  // the flat form, simply leave these blank. ----
  brandName               String?
  businessFunction        String?
  mainPurpose              String?
  supportsCustomerJourney String?
  customerFacing          String?
  connectsToSystems       String?
  providesHostingOrSoftware String?
  providesSecurityMonitoring String?
  handlesCustomerData     String?
  dataCategories          String[]        @default([])
  dataHandlingActions     String[]        @default([])
  processesOnBehalf       String?
  usesSubcontractor       String?
  operatesCrossBorder     String?
  customerImpactDescription String?
  replacementCostEstimate String?
  replacementTimeMonths   String?
  regulatoryCoreNeed      String?
  contractEndDate         String?
  contractValue           String?
  knownRegulatoryRequirement String?
  createdAt           DateTime        @default(now())
  requests            VendorRequest[]

  @@map("vendors")
}

/// One row per cycle sent — current and past. A vendor's "current status" is
/// never stored; it's derived from its most recent request.
model VendorRequest {
  id                Int                     @id @default(autoincrement())
  vendorId          Int
  vendor            Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorName        String
  status            String                  @default("Awaiting response")
  cadence           String?
  controlsSent      String[]                @default([])
  qDone             Int                     @default(0)
  qTotal            Int                     @default(0)
  evidenceRequested String[]                @default([])
  evDone            Int                     @default(0)
  evTotal           Int                     @default(0)
  sentOn            String
  due               String?
  completedOn       String?
  responses         VendorResponse[]
  evidence          VendorRequestEvidence[]

  @@index([vendorId])
  @@map("vendor_requests")
}

model VendorResponse {
  id         Int           @id @default(autoincrement())
  requestId  Int
  request    VendorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  questionId String
  value      String?
  confirmed  Boolean       @default(false)

  @@unique([requestId, questionId])
  @@map("vendor_responses")
}

model VendorRequestEvidence {
  id         Int           @id @default(autoincrement())
  requestId  Int
  request    VendorRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type       String
  status     String        @default("requested")
  fileName   String?
  receivedOn String?

  @@map("vendor_request_evidence")
}

// ---------- Issues & exceptions (8A) ----------

/// A finding raised against a vendor, tracked through remediation, exception and risk
/// acceptance to closure. `vendor` is the vendor's name, stored plainly — matching how
/// `Vendor.owner` stores a team member's name — not a foreign key.
model Issue {
  id                      Int      @id @default(autoincrement())
  vendor                  String
  title                   String
  description             String?
  severity                String
  status                  String   @default("Open")
  owner                   String
  dueDate                 String?
  exceptionJustification  String?
  exceptionStatus         String?
  riskAcceptanceRationale String?
  riskAcceptanceExpiry    String?
  riskAcceptanceStatus    String   @default("Not Required")
  closureEvidence         String?
  createdAt               DateTime @default(now())

  @@map("issues")
}

// ---------- Activity log (12) — written alongside every save/delete; shared across entities,
// matching the admin console's convention. ----------

model ActivityLog {
  id     Int      @id @default(autoincrement())
  entity String
  ts     DateTime @default(now())
  action String
  label  String
  user   String

  @@index([entity, ts])
  @@map("activity_log")
}
